pkgname=cockpit-kea
pkgver=VERSION
pkgrel=1
pkgdesc='Cockpit page for ISC Kea DHCP leases and logs'
arch=('x86_64')
url='https://github.com/sammiq/cockpit-kea'
license=(LGPL)
source=("SOURCE")
sha256sums=('SKIP')

package() {
  depends=(cockpit)
  cd $pkgname
  make DESTDIR="$pkgdir" install PREFIX=/usr
}

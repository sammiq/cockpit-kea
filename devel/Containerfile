# Development container: systemd + ISC Kea (DHCPv4 and DHCPv6) + Cockpit,
# matching the Debian Trixie production server.
#
# Built and run by `make devel-container`; see README.md.
ARG BASE=docker.io/library/debian:trixie
FROM ${BASE}

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        systemd systemd-sysv dbus iproute2 sudo busybox \
        kea-dhcp4-server kea-dhcp6-server \
        cockpit-ws cockpit-bridge cockpit-system \
 && rm -rf /var/lib/apt/lists/*

# Plain HTTP on 9090 is fine for a local dev container
RUN mkdir -p /etc/cockpit \
 && printf '[WebService]\nAllowUnencrypted=true\n' > /etc/cockpit/cockpit.conf

# Login: admin / admin. "sudo" gives Administrative access; "adm" lets it read
# the system journal with Limited access, as Debian's installer does for the
# first user.
RUN useradd -m -s /bin/bash -G sudo,adm admin && echo admin:admin | chpasswd

# Units that cannot work, or are just noise, inside a container
RUN systemctl mask systemd-resolved.service systemd-timesyncd.service \
        systemd-networkd-wait-online.service \
        getty@.service console-getty.service \
        systemd-modules-load.service sys-kernel-config.mount sys-kernel-debug.mount sys-kernel-tracing.mount \
        proc-sys-fs-binfmt_misc.automount 2>/dev/null || true

# Kea configs serving the fake LAN on kea0 (keep Debian's ownership/modes)
COPY --chown=root:_kea --chmod=0640 kea/kea-dhcp4.conf kea/kea-dhcp6.conf /etc/kea/
COPY fake-lan.sh /usr/local/bin/
COPY fake-lan.service fake-clients.service /etc/systemd/system/
RUN systemctl enable cockpit.socket fake-lan.service fake-clients.service \
        kea-dhcp4-server.service kea-dhcp6-server.service

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]

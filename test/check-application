#!/usr/bin/python3 -cimport os, sys; os.execv(os.path.dirname(sys.argv[1]) + "/common/pywrap", sys.argv)

# NOT YET RUN: needs /dev/kvm and a Cockpit test image (TEST_OS). The dev
# container (README.md) is the tested path for now. Kea itself doesn't need
# to be installed: the test writes a config and a lease file for the page.
#
# See https://github.com/cockpit-project/cockpit/blob/main/test/common/testlib.py
# "class Browser" and "class MachineCase" for the available API.

import time

import testlib


@testlib.nondestructive
class TestKea(testlib.MachineCase):
    def testBasic(self):
        b = self.browser
        m = self.machine

        if m.execute("test -d /etc/kea && echo yes || true").strip() != "yes":
            m.execute("mkdir /etc/kea")
            self.addCleanup(m.execute, "rm -rf /etc/kea")
        self.write_file("/etc/kea/kea-dhcp4.conf", """
// a comment, as Kea allows
{ "Dhcp4": {
    "lease-database": { "type": "memfile", "name": "/var/tmp/cktest-leases4.csv" },
    "subnet4": [ { "id": 1, "subnet": "192.0.2.0/24",
        "reservations": [ { "hw-address": "02:00:00:00:00:01", "ip-address": "192.0.2.10",
                            "comment": "Test reservation" } ] } ]
} }
""")
        expire = int(time.time()) + 3600
        self.write_file("/var/tmp/cktest-leases4.csv",
                        "address,hwaddr,client_id,valid_lifetime,expire,subnet_id,fqdn_fwd,fqdn_rev,"
                        "hostname,state,user_context,pool_id\n"
                        f"192.0.2.10,02:00:00:00:00:01,,3600,{expire},1,0,0,cktest-host,0,,0\n")
        self.addCleanup(m.execute, "rm -f /var/tmp/cktest-leases4.csv*")

        self.login_and_go("/kea")
        row = "#kea-leases tr[data-row-id='4/0/192.0.2.10/']"
        b.wait_in_text(row, "02:00:00:00:00:01")
        b.wait_in_text(row, "cktest-host")
        b.wait_in_text(row, "Test reservation")

        # Kea appends a row on renewal; the page follows the file
        m.execute(f"echo '192.0.2.10,02:00:00:00:00:01,,3600,{expire},1,0,0,renamed-host,0,,0' "
                  ">> /var/tmp/cktest-leases4.csv")
        b.wait_in_text(row, "renamed-host")


if __name__ == '__main__':
    testlib.test_main()
